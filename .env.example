# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

NODE_ENV=development

FRONTEND_PORT=3000
PORT=4000

FRONTEND_URL=http://localhost:3000

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

VITE_API_BASE_URL=http://localhost:4000/api

# ==========================================
# POSTGRESQL DATABASE
# ==========================================

POSTGRES_DB=docverify_db
POSTGRES_USER=docverify_user
POSTGRES_PASSWORD=change_me_local_only

# Local backend on the host (Docker maps container 5432 -> host 5433):
DATABASE_URL=postgresql://docverify_user:change_me_local_only@localhost:5433/docverify_db?schema=public

# Inside Docker Compose network, use the postgres service hostname instead:
# DATABASE_URL=postgresql://docverify_user:change_me_local_only@postgres:5432/docverify_db?schema=public

# Supabase (optional later): use the Session pooler URI from the dashboard.
# Encode special characters in the password (e.g. @ -> %40).
# Direct db.*.supabase.co hosts are often IPv6-only and may fail on local networks.

# ==========================================
# AUTHENTICATION
# ==========================================

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=15m

COOKIE_NAME=docverify_session
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# ==========================================
# SYNTHETIC SEED CREDENTIALS (development)
# ==========================================
# Used only by the Prisma seed script. Never hardcode production passwords.

SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@docverify.local
SEED_ADMIN_PASSWORD=change_me_admin_password

SEED_REVIEWER_NAME=Document Reviewer
SEED_REVIEWER_EMAIL=reviewer@docverify.local
SEED_REVIEWER_PASSWORD=change_me_reviewer_password

SEED_APPLICANT_NAME=Synthetic Applicant
SEED_APPLICANT_EMAIL=applicant@docverify.local
SEED_APPLICANT_PASSWORD=change_me_applicant_password

BCRYPT_SALT_ROUNDS=12

# ==========================================
# FILE STORAGE
# ==========================================

UPLOAD_DIR=/app/uploads

MAX_FILE_SIZE_BYTES=10485760

# ==========================================
# QDRANT VECTOR DATABASE
# ==========================================

QDRANT_URL=http://qdrant:6333

# Keep empty for local Qdrant without API-key authentication
QDRANT_API_KEY=

# ==========================================
# CORS AND SERVER
# ==========================================

CORS_ORIGIN=http://localhost:3000

HOST=0.0.0.0

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=info
