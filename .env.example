# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
# Copy to `.env` in the repository root for Docker Compose:
#   cp .env.example .env
# Never commit real `.env` files.

NODE_ENV=production

FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=4000
POSTGRES_HOST_PORT=5433
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ==========================================
# FRONTEND BUILD (Vite — baked into the image)
# ==========================================
# Browser calls the API on the host-mapped backend port.

VITE_API_BASE_URL=http://localhost:4000/api

# ==========================================
# POSTGRESQL
# ==========================================

POSTGRES_DB=docverify_db
POSTGRES_USER=docverify_user
POSTGRES_PASSWORD=change_me_local_only

# Inside Docker Compose the backend uses the postgres service hostname:
# DATABASE_URL=postgresql://docverify_user:CHANGE_ME@postgres:5432/docverify_db?schema=public
#
# Local backend on the host (postgres published on 5433):
# DATABASE_URL=postgresql://docverify_user:change_me_local_only@localhost:5433/docverify_db?schema=public
#
# Automated tests (see backend/.env.test):
# DATABASE_URL=postgresql://docverify_user:change_me_local_only@localhost:5433/docverify_test?schema=public

# ==========================================
# AUTHENTICATION
# ==========================================
# Generate a secret: openssl rand -base64 32

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=15m

COOKIE_NAME=docverify_session
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# ==========================================
# SYNTHETIC SEED CREDENTIALS (development / compose)
# ==========================================
# Used by the Prisma seed script on container start when SEED_ON_START=true.
# Never use these values in a real production deployment.

SEED_ON_START=true

SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@docverify.local
SEED_ADMIN_PASSWORD=change_me_admin_password

SEED_REVIEWER_NAME=Document Reviewer
SEED_REVIEWER_EMAIL=reviewer@docverify.local
SEED_REVIEWER_PASSWORD=change_me_reviewer_password

SEED_APPLICANT_NAME=Synthetic Applicant
SEED_APPLICANT_EMAIL=applicant@docverify.local
SEED_APPLICANT_PASSWORD=change_me_applicant_password

BCRYPT_SALT_ROUNDS=12

# ==========================================
# FILE STORAGE
# ==========================================
# Inside Compose the backend mounts a named volume at /app/uploads.

UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_BYTES=10485760

# ==========================================
# QDRANT VECTOR DATABASE
# ==========================================
# Compose service hostname for the API container:

QDRANT_URL=http://qdrant:6333

# Keep empty for the local Compose Qdrant without API-key authentication.
QDRANT_API_KEY=

# ==========================================
# BACKEND SERVER
# ==========================================

PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
