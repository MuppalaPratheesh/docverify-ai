
# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

NODE_ENV=development

FRONTEND_PORT=3000
PORT=4000

FRONTEND_URL=http://localhost:3000

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

VITE_API_BASE_URL=http://localhost:4000/api

# ==========================================
# POSTGRESQL DATABASE
# ==========================================

POSTGRES_DB=docverify_db
POSTGRES_USER=docverify_user
POSTGRES_PASSWORD=change_me_local_only

# Backend Docker container uses the service name
DATABASE_URL=postgresql://docverify_user:change_me_local_only@postgres:5432/docverify_db?schema=public

# ==========================================
# AUTHENTICATION
# ==========================================

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=15m

COOKIE_NAME=docverify_session
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# ==========================================
# FILE STORAGE
# ==========================================

UPLOAD_DIR=/app/uploads

MAX_FILE_SIZE_BYTES=10485760

# ==========================================
# QDRANT VECTOR DATABASE
# ==========================================

QDRANT_URL=http://qdrant:6333

# Keep empty for local Qdrant without API-key authentication
QDRANT_API_KEY=

# ==========================================
# CORS AND SERVER
# ==========================================

CORS_ORIGIN=http://localhost:3000

HOST=0.0.0.0

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=info
