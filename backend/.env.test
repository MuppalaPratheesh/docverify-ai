NODE_ENV=test
PORT=4001
HOST=0.0.0.0

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Dedicated test database on the same local Postgres instance (host 5433).
# Never point this at a production database.
DATABASE_URL=postgresql://docverify_user:change_me_local_only@localhost:5433/docverify_test?schema=public

JWT_SECRET=test_only_jwt_secret_do_not_reuse
JWT_EXPIRES_IN=15m

COOKIE_NAME=docverify_session
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

UPLOAD_DIR=./uploads-test
MAX_FILE_SIZE_BYTES=10485760

LOG_LEVEL=error

# Synthetic credentials used only by the automated test suite seed.
SEED_ADMIN_NAME=Test Administrator
SEED_ADMIN_EMAIL=admin@docverify.test
SEED_ADMIN_PASSWORD=TestAdminPass123!

SEED_REVIEWER_NAME=Test Reviewer
SEED_REVIEWER_EMAIL=reviewer@docverify.test
SEED_REVIEWER_PASSWORD=TestReviewerPass123!

SEED_APPLICANT_NAME=Test Applicant
SEED_APPLICANT_EMAIL=applicant@docverify.test
SEED_APPLICANT_PASSWORD=TestApplicantPass123!

# Faster hashing for deterministic automated tests (still within allowed range).
BCRYPT_SALT_ROUNDS=10
