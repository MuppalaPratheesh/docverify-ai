# Backend-local overrides (optional). Root .env.example is the shared source of truth.
# For local development outside Docker, prefer localhost for database hosts.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://docverify_user:change_me_local_only@localhost:5432/docverify_db?schema=public

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=15m

COOKIE_NAME=docverify_session
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

LOG_LEVEL=info
