# Backend-local overrides (optional). Root .env.example is the shared source of truth.
# For local development with Docker Compose postgres mapped to host port 5433:

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://docverify_user:change_me_local_only@localhost:5433/docverify_db?schema=public

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=15m

COOKIE_NAME=docverify_session
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

LOG_LEVEL=info

# ==========================================
# SYNTHETIC SEED CREDENTIALS (development)
# ==========================================
# Required for `npm run prisma:seed`. Do not use these values in production.

SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@docverify.local
SEED_ADMIN_PASSWORD=change_me_admin_password

SEED_REVIEWER_NAME=Document Reviewer
SEED_REVIEWER_EMAIL=reviewer@docverify.local
SEED_REVIEWER_PASSWORD=change_me_reviewer_password

SEED_APPLICANT_NAME=Synthetic Applicant
SEED_APPLICANT_EMAIL=applicant@docverify.local
SEED_APPLICANT_PASSWORD=change_me_applicant_password

BCRYPT_SALT_ROUNDS=12
